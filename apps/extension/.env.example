# API / Web アプリの URL
VITE_API_BASE_URL=http://localhost:8787
VITE_WEB_APP_URL=http://localhost:5173

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Web アプリの origin。設定すると Web でのサインインセッションが拡張機能へ同期される
# (Clerk Sync Host)。manifest.json の host_permissions に同じ origin が必要。
VITE_CLERK_SYNC_HOST=http://localhost:5173
