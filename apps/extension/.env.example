# Deprecated alias for development. Prefer .env.development.example and .env.development.local.
# API / Web アプリの URL
VITE_API_BASE_URL=http://localhost:8787
VITE_WEB_APP_URL=http://localhost:5173

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Clerk Sync Host。開発時は Clerk 公式手順どおりポートなしの localhost を指定する。
# manifest.json の host_permissions に同じ host が必要。
VITE_CLERK_SYNC_HOST=http://localhost
