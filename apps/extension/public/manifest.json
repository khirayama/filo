{
  "manifest_version": 3,
  "name": "Filo Reader",
  "version": "0.1.0",
  "description": "Read a Filo reading list in the original article pages",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["cookies", "scripting", "storage", "tabs", "tts"],
  "host_permissions": ["http://*/*", "https://*/*", "https://www.google-analytics.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  }
}
