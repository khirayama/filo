CLERK_SECRET_KEY=sk_test_your_secret_key
CURSOR_SECRET=local-dev-cursor-secret
ADMIN_CLERK_USER_IDS=

# Title translation -> local LM Studio (OpenAI-compatible /v1/chat/completions).
# URL/key are optional and default to a local unauthenticated server; the model
# must be loaded in LM Studio (`lms ps`).
LM_STUDIO_API_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=
TRANSLATION_MODEL=google/gemma-4-12b-qat
