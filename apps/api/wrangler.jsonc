{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "filo-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Title translation runs on-device, so the worker no longer owns a
  // translation drain, its queue, or the watchdog that restarted it.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TranslationWatchdog"] },
    { "tag": "v2", "deleted_classes": ["TranslationWatchdog"] }
  ],
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "filo-jobs" }
    ],
    "consumers": [
      {
        "queue": "filo-jobs",
        "max_batch_size": 5,
        "max_retries": 5,
        "max_batch_timeout": 5
      }
    ]
  },
  // Cron only retries failed account-deletion jobs; feed refresh is manual (user-triggered).
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    // Comma separated Clerk user ids that may call /api/v1/admin/*
    "ADMIN_CLERK_USER_IDS": ""
  }
  // Secrets (set via `wrangler secret put`):
  //   CLERK_SECRET_KEY    - Clerk backend API key (token verification + account deletion)
  //   CURSOR_SECRET       - HMAC key for tamper-evident pagination cursors
  //   CRON_SECRET         - Bearer token for internal cron → API calls
}
