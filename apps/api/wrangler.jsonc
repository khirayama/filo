{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "filo-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Safety-net watchdog that restarts a stalled translation drain (its alarm is
  // persisted, so the backlog resumes after a crash or a local dev restart).
  "durable_objects": {
    "bindings": [
      { "name": "TRANSLATION_WATCHDOG", "class_name": "TranslationWatchdog" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TranslationWatchdog"] }
  ],
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "filo-jobs" },
      { "binding": "TRANSLATE_JOBS", "queue": "filo-translate" }
    ],
    "consumers": [
      {
        "queue": "filo-jobs",
        "max_batch_size": 5,
        "max_retries": 5,
        "max_batch_timeout": 5
      },
      // Translation drains run strictly one at a time: the provider's rate
      // limit is account-global, so parallel consumers would starve each other.
      {
        "queue": "filo-translate",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 5,
        "max_batch_timeout": 0
      }
    ]
  },
  // Cron only retries failed account-deletion jobs; feed refresh is manual (user-triggered).
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    // Comma separated Clerk user ids that may call /api/v1/admin/*
    "ADMIN_CLERK_USER_IDS": ""
  }
  // Secrets (set via `wrangler secret put`):
  //   CLERK_SECRET_KEY    - Clerk backend API key (token verification + account deletion)
  //   CURSOR_SECRET       - HMAC key for tamper-evident pagination cursors
  //   LM_STUDIO_API_KEY   - optional auth token for the OpenAI-compatible translation endpoint
  //   LM_STUDIO_API_URL   - LM Studio base URL (optional, defaults to http://localhost:1234/v1)
  //   TRANSLATION_MODEL   - LM Studio model identifier to use for translation
  //   CRON_SECRET         - Bearer token for internal cron → API calls
}
